# Database (Supabase)
# Sign up at https://supabase.com/
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# AI Engine (Gemini)
# Get a free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LinkedIn API (OAuth 2.0 Client)
# Create a developer app at https://developer.linkedin.com/
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
LINKEDIN_ACCESS_TOKEN=your_access_token_via_helper
LINKEDIN_URN=urn:li:person:your_urn_here

# Admin Dashboard Auth
# Used for the login window in the admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password
